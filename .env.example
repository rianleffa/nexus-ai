# NEXUS AI — variáveis públicas do frontend.
# Use a URL base do projeto Supabase, sem /rest/v1.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Alternativa legada à publishable key (configure apenas uma das duas chaves).
VITE_SUPABASE_ANON_KEY=

# GEMINI_API_KEY é usada apenas como segredo da Supabase Edge Function.
# Configure-a no ambiente de Edge Functions do Supabase; não a coloque em VITE_.
