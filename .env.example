# NEXUS AI — variáveis públicas do frontend.
# Use a URL base do projeto Supabase, sem /rest/v1.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Alternativa legada à publishable key (configure apenas uma das duas chaves).
VITE_SUPABASE_ANON_KEY=

# A chave Gemini não pertence ao ambiente Vite. Para desenvolvimento local,
# configure-a em supabase/functions/.env; em produção, use Supabase Edge Function Secrets.
